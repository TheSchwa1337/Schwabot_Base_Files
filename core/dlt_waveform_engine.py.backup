    class UnifiedMathFallback:
        @staticmethod
        def sin(x):
            return np.sin(x)
        
        @staticmethod 
        def exp(x):
            return np.exp(x)
        
        @staticmethod
        def abs(x):
            return np.abs(x)
        
        @staticmethod
        def max(x, y):
            return max(x, y)
        
        @staticmethod
        def min(x, y):
            return min(x, y)
        
        @staticmethod
        def mean(x):
            return np.mean(x)
        
        @staticmethod
        def std(x):
