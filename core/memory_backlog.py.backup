import collections
import hashlib
import json
import os
import time

class MemoryBacklog:
    def __init__(self, config: dict):
    self.enabled = config.get("enabled", True)
    self.short_term_depth = config.get("backlog_depth", {}).get("short_term", 96)
    self.mid_term_depth = config.get("backlog_depth", {}).get("mid_term", 672)
    self.long_term_depth = config.get("backlog_depth", {}).get("long_term", 8760)
    self.similarity_check = config.get("similarity_check", True)
    self.rebalance_trigger = config.get("rebalance_trigger", True)
    self.hash_block_type = config.get("hash_block_type", "SHA-512")
    self.store_vectors_in = config.get("store_vectors_in", "./memory_bank/profit_vectors/")
    self.hash_match_threshold = config.get("hash_match_threshold", 0.87)
    self.confidence_decay = config.get("confidence_decay", 0.008)
    self.correlation_matrix_update_interval = self._parse_time_string(config.get("correlation_matrix_update", "1h"))
    self.vector_confluence_policy = config.get("vector_confluence_policy", "weighted_overlap")

    self.short_term_memory = collections.deque(maxlen = self.short_term_depth)
    self.mid_term_memory = collections.deque(maxlen = self.mid_term_depth)
    self.long_term_memory = collections.deque(maxlen = self.long_term_depth)
    self.last_correlation_update_time = time.time()

    os.makedirs(self.store_vectors_in, exist_ok = True)

    def _parse_time_string(self, time_str: str) -> int:
    """Parses a time string like '45s', '5m' into seconds."""
        if time_str.endswith('s'):
        return int(time_str[:-1])
        elif time_str.endswith('m'):
        return int(time_str[:-1]) * 60
        elif time_str.endswith('h'):
        return int(time_str[:-1]) * 3600
        else:
            return int(time_str) # Assume seconds if no suffix

    def _calculate_hash_similarity(self, hash1: str, hash2: str) -> float:
    """"""
    Calculates a simple Jaccard-like similarity between two hex hashes.
        This is a conceptual similarity for bit-level overlap.
    """"""
        # Convert hex hashes to binary strings for bitwise comparison
        bin1 = bin(int(hash1, 16))[2:].zfill(len(hash1) * 4) # *4 for bits per hex char
    bin2 = bin(int(hash2, 16))[2:].zfill(len(hash2) * 4)

        if len(bin1) != len(bin2): return 0.0:

        intersection = sum(1 for b1, b2 in zip(bin1, bin2) if b1 == b2)
    union = len(bin1) # For same length strings, union is just the length

    return intersection / union

    def add_profit_vector(self, vector_data: dict, timeframe: str):
    """"""
    Adds a profit vector to the specified memory backlog.
    Vector data should include a 'hash' key.
    """"""
        if not self.enabled: return:

    vector_data["timestamp"] = time.time()

        if timeframe == "short_term":
        self.short_term_memory.append(vector_data)
        elif timeframe == "mid_term":
        self.mid_term_memory.append(vector_data)
            elif timeframe == "long_term":
        self.long_term_memory.append(vector_data)
                else:
            raise ValueError(f"Invalid timeframe: {timeframe}")

            self._save_vector_to_disk(vector_data)

    def _save_vector_to_disk(self, vector_data: dict):
    """"""
    Saves a profit vector to a JSON file on disk.
    """"""
    timestamp_str = time.strftime("%Y%m%d_%H%M%S", time.localtime(vector_data["timestamp"]))
    hash_prefix = vector_data.get("hash", "nohash")[:8]
    filename = os.path.join(self.store_vectors_in, f"profit_vector_{timestamp_str}_{hash_prefix}.json")
        with open(filename, 'w') as f:
        json.dump(vector_data, f, indent=2)

    def check_similar_vectors(self, current_hash: str, timeframe: str) -> list[dict]:
    """"""
        Checks for similar vectors in the backlog for a given hash and timeframe.
    """"""
        if not self.enabled or not self.similarity_check: return []:

    target_memory = collections.deque()
        if timeframe == "short_term":
        target_memory = self.short_term_memory
        elif timeframe == "mid_term":
        target_memory = self.mid_term_memory
            elif timeframe == "long_term":
        target_memory = self.long_term_memory
                else:
        return []

        similar_vectors = []
                for vector in target_memory:
                    if self._calculate_hash_similarity(current_hash, vector.get("hash", "")) >= self.hash_match_threshold:
                similar_vectors.append(vector)
            return similar_vectors

    def get_backlog_summary(self) -> dict:
    """"""
    Returns a summary of the current backlog sizes.
    """"""
    return {)
        "short_term_count": len(self.short_term_memory),
        "mid_term_count": len(self.mid_term_memory),
        "long_term_count": len(self.long_term_memory),
        "store_path": self.store_vectors_in
    } 