# -*- coding: utf-8 -*-
"""
Flake8 Positional Corrector for Schwabot MathLib
================================================

Comprehensive Flake8 correction system that works with the positional state
system to fix syntax errors while preserving mathematical integrity across
all MathLib versions (V2, V3, V4, Unified).

Key Features:
- Positional state-aware corrections
- Mathematical formula preservation
- 32-bit phase orientation support
- UTF-8 compatibility with emoji handling
- Dependency relationship preservation
- Comprehensive error tracking and reporting

Mathematical Foundation:
- Preserves all mathematical formulas and logic
- Maintains version interdependencies
- Ensures proper bit-phase transitions
- Handles tensor operations and BTC price hashing
"""

from __future__ import annotations
from typing import Dict, List, Optional, Any, Union, Tuple, Set
import logging
import re
import time
import json
import hashlib
from pathlib import Path
from dataclasses import dataclass

from .mathlib_positional_state_system import (
    MathLibPositionalStateSystem, 
    MathLibVersion, 
    BitPhase,
    positional_state_system
)

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

@dataclass
class Flake8Correction:
    """Represents a Flake8 correction."""
    error_code: str
    line_number: int
    original_line: str
    corrected_line: str
    explanation: str
    priority: str
    mathematical_preservation: bool = False

class Flake8PositionalCorrector:
    """Comprehensive Flake8 correction system with positional state awareness."""
    
    def __init__(self):
        """Initialize the Flake8 positional corrector."""
        self.positional_system = positional_state_system
        self.correction_history: List[Flake8Correction] = []
        self.preserved_formulas: List[str] = []
        self.utf8_compatibility = True
        
        # Mathematical preservation patterns
        self.math_preservation_patterns = [
            r'# MATHEMATICAL PRESERVATION:',
            r'#.*?mathematical.*?formula',
            r'#.*?BTC.*?price.*?hashing',
            r'#.*?tensor.*?operation',
            r'#.*?bit.*?phase',
            r'#.*?thermal.*?correction'
        ]
        
        logger.info("Flake8 Positional Corrector initialized")
    
    def correct_file(self, file_path: str, version: Optional[MathLibVersion] = None) -> Dict[str, Any]:
        """Correct Flake8 errors in a file while preserving mathematical content."""
        try:
            # Read file content
            with open(file_path, 'r', encoding='utf-8') as f:
                content = f.read()
            
            # Determine MathLib version if not provided
            if not version:
                version = self._determine_mathlib_version(file_path, content)
            
            if not version:
                return {"error": f"Could not determine MathLib version for {file_path}"}
            
            # Extract and preserve mathematical formulas
            preserved_formulas = self._extract_mathematical_formulas(content)
            self.preserved_formulas.extend(preserved_formulas)
            
            # Apply 32-bit phase orientation
            phase_result = self.positional_system.apply_32bit_phase_orientation(version)
            
            # Correct Flake8 errors
            corrected_content, corrections = self._correct_content(content, version)
            
            # Update positional state
            self.positional_system.update_positional_state(
                version,
                mathematical_formulas=preserved_formulas,
                flake8_errors=[corr.error_code for corr in corrections]
            )
            
            # Write corrected content
            backup_path = f"{file_path}.backup_{int(time.time())}"
            with open(backup_path, 'w', encoding='utf-8') as f:
                f.write(content)
            
            with open(file_path, 'w', encoding='utf-8') as f:
                f.write(corrected_content)
            
            return {
                "file_path": file_path,
                "version": version.value,
                "bit_phase": phase_result["bit_phase"],
                "corrections_applied": len(corrections),
                "formulas_preserved": len(preserved_formulas),
                "backup_created": backup_path,
                "utf8_compatible": self.utf8_compatibility,
                "corrections": [self._correction_to_dict(corr) for corr in corrections]
            }
            
        except Exception as e:
            logger.error(f"Error correcting file {file_path}: {e}")
            return {"error": str(e)}
    
    def _determine_mathlib_version(self, file_path: str, content: str) -> Optional[MathLibVersion]:
        """Determine which MathLib version a file belongs to."""
        file_name = Path(file_path).name.lower()
        
        if 'mathlib_v1' in file_name or ('mathlib' in file_name and 'v2' not in file_name and 'v3' not in file_name and 'v4' not in file_name):
            return MathLibVersion.V1
        elif 'mathlib_v2' in file_name:
            return MathLibVersion.V2
        elif 'mathlib_v3' in file_name:
            return MathLibVersion.V3
        elif 'mathlib_v4' in file_name:
            return MathLibVersion.V4
        elif 'unified_math' in file_name:
            return MathLibVersion.UNIFIED
        
        # Check content for version indicators
        if 'version = "1.0' in content or 'MathLib(' in content:
            return MathLibVersion.V1
        elif 'version = "2.0' in content or 'MathLibV2' in content:
            return MathLibVersion.V2
        elif 'version = "3.0' in content or 'MathLibV3' in content:
            return MathLibVersion.V3
        elif 'version = "4.0' in content or 'MathLibV4' in content:
            return MathLibVersion.V4
        elif 'UnifiedMathSystem' in content:
            return MathLibVersion.UNIFIED
        
        return None
    
    def _extract_mathematical_formulas(self, content: str) -> List[str]:
        """Extract mathematical formulas from content while preserving them."""
        formulas = []
        
        # Look for mathematical preservation comments
        for pattern in self.math_preservation_patterns:
            matches = re.findall(pattern, content, re.MULTILINE | re.IGNORECASE)
            formulas.extend(matches)
        
        # Look for mathematical operations
        math_patterns = [
            r'def\s+\w+.*?return.*?(?=\n\s*\n|\n\s*def|\Z)',
            r'class\s+\w+.*?def.*?(?=\n\s*\n|\n\s*class|\Z)',
            r'#.*?mathematical.*?formula.*?(?=\n|$)',
            r'#.*?BTC.*?price.*?hashing.*?(?=\n|$)',
            r'#.*?tensor.*?operation.*?(?=\n|$)',
            r'#.*?bit.*?phase.*?(?=\n|$)',
            r'#.*?thermal.*?correction.*?(?=\n|$)'
        ]
        
        for pattern in math_patterns:
            matches = re.findall(pattern, content, re.MULTILINE | re.IGNORECASE)
            formulas.extend(matches)
        
        return list(set(formulas))  # Remove duplicates
    
    def _correct_content(self, content: str, version: MathLibVersion) -> Tuple[str, List[Flake8Correction]]:
        """Correct Flake8 errors in content while preserving mathematical formulas."""
        lines = content.split('\n')
        corrections = []
        corrected_lines = []
        
        for i, line in enumerate(lines, 1):
            original_line = line
            corrected_line = line
            
            # Skip lines with mathematical preservation
            if any(pattern.replace(r'.*?', '') in line for pattern in self.math_preservation_patterns):
                corrected_lines.append(line)
                continue
            
            # Fix common Flake8 E999 syntax errors
            if line.strip() and not line.strip().startswith('#'):
                # Fix unmatched quotes
                if line.count('"') % 2 != 0:
                    corrected_line = self._fix_unmatched_quotes(line)
                    if corrected_line != line:
                        corrections.append(Flake8Correction(
                            error_code="E999",
                            line_number=i,
                            original_line=original_line,
                            corrected_line=corrected_line,
                            explanation="Fixed unmatched quotes",
                            priority="high"
                        ))
                
                # Fix invalid assignment syntax
                if '=' in line and '==' not in line:
                    if not re.search(r'\s*=\s*', line):
                        corrected_line = self._fix_assignment_syntax(line)
                        if corrected_line != line:
                            corrections.append(Flake8Correction(
                                error_code="E999",
                                line_number=i,
                                original_line=original_line,
                                corrected_line=corrected_line,
                                explanation="Fixed assignment syntax",
                                priority="high"
                            ))
                
                # Fix invalid syntax patterns
                corrected_line = self._fix_syntax_patterns(corrected_line)
                if corrected_line != line:
                    corrections.append(Flake8Correction(
                        error_code="E999",
                        line_number=i,
                        original_line=original_line,
                        corrected_line=corrected_line,
                        explanation="Fixed syntax patterns",
                        priority="medium"
                    ))
            
            corrected_lines.append(corrected_line)
        
        return '\n'.join(corrected_lines), corrections
    
    def _fix_unmatched_quotes(self, line: str) -> str:
        """Fix unmatched quotes in a line."""
        # Count quotes
        double_quotes = line.count('"')
        single_quotes = line.count("'")
        
        # Fix unmatched double quotes
        if double_quotes % 2 != 0:
            # Find the last unmatched quote
            last_quote_pos = line.rfind('"')
            if last_quote_pos != -1:
                # Add closing quote at the end
                line = line + '"'
        
        # Fix unmatched single quotes
        if single_quotes % 2 != 0:
            # Find the last unmatched quote
            last_quote_pos = line.rfind("'")
            if last_quote_pos != -1:
                # Add closing quote at the end
                line = line + "'"
        
        return line
    
    def _fix_assignment_syntax(self, line: str) -> str:
        """Fix assignment syntax in a line."""
        # Find assignment operator
        assignment_pos = line.find('=')
        if assignment_pos != -1:
            # Ensure proper spacing around assignment
            before_assignment = line[:assignment_pos].rstrip()
            after_assignment = line[assignment_pos + 1:].lstrip()
            line = f"{before_assignment} = {after_assignment}"
        
        return line
    
    def _fix_syntax_patterns(self, line: str) -> str:
        """Fix common syntax patterns."""
        # Fix spacing around operators
        operators = ['+', '-', '*', '/', '//', '%', '**', '==', '!=', '<=', '>=', '<', '>']
        for op in operators:
            if op in line:
                # Ensure proper spacing around operators
                line = re.sub(rf'(\S)\s*{re.escape(op)}\s*(\S)', rf'\1 {op} \2', line)
        
        # Fix trailing whitespace
        line = line.rstrip()
        
        # Fix multiple spaces
        line = re.sub(r' +', ' ', line)
        
        return line
    
    def _correction_to_dict(self, correction: Flake8Correction) -> Dict[str, Any]:
        """Convert Flake8Correction to dictionary."""
        return {
            "error_code": correction.error_code,
            "line_number": correction.line_number,
            "original_line": correction.original_line,
            "corrected_line": correction.corrected_line,
            "explanation": correction.explanation,
            "priority": correction.priority,
            "mathematical_preservation": correction.mathematical_preservation
        }
    
    def correct_mathlib_directory(self, directory_path: str) -> Dict[str, Any]:
        """Correct all MathLib files in a directory."""
        directory = Path(directory_path)
        results = {
            "directory": str(directory),
            "files_processed": 0,
            "files_corrected": 0,
            "total_corrections": 0,
            "total_formulas_preserved": 0,
            "errors": [],
            "file_results": []
        }
        
        # Find all Python files
        python_files = list(directory.glob("*.py"))
        
        for file_path in python_files:
            try:
                result = self.correct_file(str(file_path))
                results["files_processed"] += 1
                
                if "error" not in result:
                    results["files_corrected"] += 1
                    results["total_corrections"] += result.get("corrections_applied", 0)
                    results["total_formulas_preserved"] += result.get("formulas_preserved", 0)
                    results["file_results"].append(result)
                else:
                    results["errors"].append({
                        "file": str(file_path),
                        "error": result["error"]
                    })
                
            except Exception as e:
                results["errors"].append({
                    "file": str(file_path),
                    "error": str(e)
                })
        
        return results
    
    def generate_correction_report(self, results: Dict[str, Any]) -> str:
        """Generate a comprehensive correction report."""
        report_lines = [
            "🧮 Flake8 Positional Correction Report",
            "=" * 50,
            f"Directory: {results.get('directory', 'Unknown')}",
            f"Files Processed: {results.get('files_processed', 0)}",
            f"Files Corrected: {results.get('files_corrected', 0)}",
            f"Total Corrections: {results.get('total_corrections', 0)}",
            f"Formulas Preserved: {results.get('total_formulas_preserved', 0)}",
            "",
            "📊 File Results:",
            "-" * 20
        ]
        
        for file_result in results.get("file_results", []):
            report_lines.extend([
                f"  📄 {file_result.get('file_path', 'Unknown')}",
                f"    Version: {file_result.get('version', 'Unknown')}",
                f"    Bit Phase: {file_result.get('bit_phase', 'Unknown')}",
                f"    Corrections: {file_result.get('corrections_applied', 0)}",
                f"    Formulas: {file_result.get('formulas_preserved', 0)}",
                ""
            ])
        
        if results.get("errors"):
            report_lines.extend([
                "❌ Errors:",
                "-" * 10
            ])
            for error in results["errors"]:
                report_lines.append(f"  {error['file']}: {error['error']}")
        
        return "\n".join(report_lines)
    
    def save_correction_report(self, results: Dict[str, Any], file_path: str) -> None:
        """Save correction report to file."""
        try:
            report = self.generate_correction_report(results)
            with open(file_path, 'w', encoding='utf-8') as f:
                f.write(report)
            logger.info(f"Correction report saved to {file_path}")
        except Exception as e:
            logger.error(f"Error saving correction report: {e}")


# Global instance
flake8_corrector = Flake8PositionalCorrector()


def main() -> None:
    """Main function for testing the Flake8 positional corrector."""
    try:
        print("🧮 Flake8 Positional Corrector - Testing")
        
        # Test correction on core directory
        core_dir = Path(__file__).parent
        results = flake8_corrector.correct_mathlib_directory(str(core_dir))
        
        # Generate and display report
        report = flake8_corrector.generate_correction_report(results)
        print(report)
        
        # Save report
        flake8_corrector.save_correction_report(results, "flake8_correction_report.txt")
        
        # Save positional state report
        positional_state_system.save_state_report("mathlib_positional_state_report.json")
        
        print("🎉 Flake8 positional correction test completed successfully!")
        
    except Exception as e:
        logger.error(f"Error in main test: {e}")
        print(f"❌ Test failed: {e}")


if __name__ == "__main__":
    main() 