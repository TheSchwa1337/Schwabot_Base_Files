"""core/decimals_autotuner.py

Background task that analyses recent PriceEvents and adjusts the global BTC
decimal precision to a useful minimum (noise-aware).
"""
from __future__ import annotations

import asyncio
import logging
from statistics import mean
from typing import List

from core.price_event_registry import last
from core.price_precision_utils import _set_runtime_decimals

logger = logging.getLogger(__name__)

# ---------------------------------------------------------------------------
# Tunable constants
# ---------------------------------------------------------------------------

WINDOW_SIZE: int = 1_000          # events analysed per pass
POLL_SECONDS: int = 15            # how often to run
SIGNAL_THRESHOLD: float = 0.1     # 10 % of mean price delta

# ---------------------------------------------------------------------------


def _choose_decimals(prices: List[float]) -> int:
    """Return best decimals from 2-8 inclusive given *prices* history."""
    if len(prices) < 10:
        return 8  # default until we have enough data

    deltas = [abs(b - a) for a, b in zip(prices, prices[1:])]
    mean_delta = mean(deltas) if deltas else 0.0
    if mean_delta == 0:
        return 2

    best = 2
    for d in range(2, 9):  # 2..8
        rounded = [round(p, d) for p in prices]
        collisions = sum(1 for a, b in zip(rounded, rounded[1:]) if a == b)
        collision_rate = collisions / (len(rounded) - 1)
        noise = collision_rate * mean_delta
        if noise < SIGNAL_THRESHOLD * mean_delta:
            best = d
        else:
            break
    return best


async def autotune_loop() -> None:
    """Main coroutine—run forever adjusting decimals."""
    logger.info("📐 Decimals autotuner started (every %ss)", POLL_SECONDS)
    while True:
        try:
            events = last(WINDOW_SIZE)
            prices = [e.raw_price for e in events]
            new_dec = _choose_decimals(prices)
            _set_runtime_decimals(new_dec)
            logger.debug("🛠  autotuner set decimals=%s (window=%s)", new_dec, len(prices))
        except Exception as e:
            logger.debug("autotuner error: %s", e)
        await asyncio.sleep(POLL_SECONDS) 

