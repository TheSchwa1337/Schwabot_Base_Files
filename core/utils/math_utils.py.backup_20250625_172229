        Phase collapse value
    """
    try:
        # Sigmoid decay function
        sigmoid = 1.0 / (1.0 + np.exp(-ω * (t - λ)))
        collapse = 1.0 - sigmoid

        return float(collapse)
    except Exception:
        return 0.5


