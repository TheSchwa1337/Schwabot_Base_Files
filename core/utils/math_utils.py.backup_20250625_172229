    Args:
        initial: Initial value
        growth_rate: Growth rate per period
        periods: Number of periods

    Returns:
        Growth factor
    """
    try:
        growth_factor = initial * ((1 + growth_rate) ** periods)
        return float(growth_factor)
    except Exception:
