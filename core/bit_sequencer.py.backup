# -*- coding: utf-8 -*-
"""
Bit Sequencer Engine
====================

Provides bit sequence generation and analysis with 32-bit phase integration
for trading signal processing and mathematical operations.

Mathematical Foundation:
    - Hash-based bit sequence generation with phase-bit integration
    - Entropy calculations with thermal state management
    - Pattern detection with dualistic mode support
    - Sequence analysis with 32-bit precision
"""

from __future__ import annotations
from typing import Dict, List, Optional, Any, Tuple, Union
from dual_unicore_handler import DualUnicoreHandler
import hashlib
import numpy as np
import logging

# MATHEMATICAL PRESERVATION: Mathematical logic or formula preserved below:
from core.phase_bit_integration import BitPhase, StrategyType, PhaseBitIntegration
# MATHEMATICAL PRESERVATION: Mathematical logic or formula preserved below:
from core.unified_profit_vectorization_system import UnifiedProfitVectorizationSystem
# MATHEMATICAL PRESERVATION: Mathematical logic or formula preserved below:
from core.unified_math_system import unified_math

# Initialize Unicode handler
unicore = DualUnicoreHandler()

# Configure logging
logger = logging.getLogger(__name__)

# Thermal state constants for bit sequencing operations
COOL = "cool"      # Low thermal state (4-bit operations)
WARM = "warm"      # Mid thermal state (8-bit operations) 
HOT = "hot"        # High thermal state (32-bit operations)
CRITICAL = "critical"  # Extreme thermal state (42-bit operations)

class BitSequencer:
    """Bit sequencer with 32-bit phase integration and thermal management."""
    
    def __init__(self):
        """Initialize bit sequencer with phase-bit integration."""
        self.phase_bit_integration = PhaseBitIntegration()
        self.profit_vectorization = UnifiedProfitVectorizationSystem()
        self.thermal_state = WARM  # Default to warm state
        self.dualistic_mode = False
        self.current_bit_phase = BitPhase.EIGHT_BIT
        self.sequence_memory: Dict[str, Any] = {}
        
        logger.info("BitSequencer initialized with 32-bit phase integration")
    
    def generate_sequence(self, hash_value: str, length: int = 256) -> Dict[str, Any]:
        """Generate bit sequence with 32-bit phase consideration and thermal management."""
        try:
            # Determine thermal state based on hash complexity
            thermal_state = self._determine_thermal_state(hash_value)
            
            # Get bit phase resolution for sequence generation
            bit_phase_result = self.phase_bit_integration.resolve_bit_phase(
                hash_value, "auto"
            )
            
            # Update current bit phase
            self.current_bit_phase = bit_phase_result.bit_phase
            
            # Determine if dualistic mode is needed (32-bit operations)
            dualistic_mode = bit_phase_result.bit_phase == BitPhase.THIRTY_TWO_BIT
            
            # Generate sequence based on bit phase
            sequence = self._generate_sequence_by_phase(hash_value, length, bit_phase_result, thermal_state)
            
            # Calculate sequence metrics
            sequence_metrics = self._calculate_sequence_metrics(sequence, bit_phase_result, thermal_state)
            
            logger.debug(f"Generated sequence length: {len(sequence)}")
            
            return {
                "sequence": sequence,
                "sequence_metrics": sequence_metrics,
                "thermal_state": thermal_state,
                "bit_phase": bit_phase_result.bit_phase.value,
                "dualistic_mode": dualistic_mode,
                "confidence": bit_phase_result.confidence,
                "strategy_type": bit_phase_result.strategy_type.value
            }
            
        except Exception as e:
            logger.error(f"Error generating sequence: {e}")
            return {"error": str(e)}
    
    def analyze_sequence(self, sequence: List[int], sequence_id: str) -> Dict[str, Any]:
        """Analyze bit sequence with 32-bit phase integration."""
        try:
            thermal_state = self._determine_thermal_state(sequence_id)
            bit_phase_result = self.phase_bit_integration.resolve_bit_phase(sequence_id, "auto")
            
            # Calculate entropy
            entropy = self._calculate_entropy(sequence)
            
            # Detect patterns
            patterns = self._detect_patterns(sequence)
            
            # Calculate complexity
            complexity = self._calculate_complexity(sequence)
            
            # Analyze runs
            run_analysis = self._analyze_runs(sequence)
            
            # Calculate autocorrelation
            autocorrelation = self._calculate_autocorrelation(sequence)
            
            analysis_result = {
                "entropy": entropy,
                "patterns": patterns,
                "complexity": complexity,
                "run_analysis": run_analysis,
                "autocorrelation": autocorrelation,
                "thermal_state": thermal_state,
                "bit_phase": bit_phase_result.bit_phase.value,
                "dualistic_mode": bit_phase_result.bit_phase == BitPhase.THIRTY_TWO_BIT,
                "confidence": bit_phase_result.confidence
            }
            
            return analysis_result
            
        except Exception as e:
            logger.error(f"Error analyzing sequence: {e}")
            return {"error": str(e)}
    
    def compare_sequences(self, seq1: List[int], seq2: List[int], comparison_id: str) -> Dict[str, Any]:
        """Compare two bit sequences with 32-bit phase integration."""
        try:
            thermal_state = self._determine_thermal_state(comparison_id)
            bit_phase_result = self.phase_bit_integration.resolve_bit_phase(comparison_id, "auto")
            
            # Calculate correlation
            correlation = self._calculate_correlation(seq1, seq2)
            
            # Calculate Hamming distance
            hamming_distance = self._calculate_hamming_distance(seq1, seq2)
            
            # Calculate similarity score
            similarity = self._calculate_similarity(seq1, seq2)
            
            return {
                "correlation": correlation,
                "hamming_distance": hamming_distance,
                "similarity": similarity,
                "thermal_state": thermal_state,
                "bit_phase": bit_phase_result.bit_phase.value,
                "dualistic_mode": bit_phase_result.bit_phase == BitPhase.THIRTY_TWO_BIT
            }
            
        except Exception as e:
            logger.error(f"Error comparing sequences: {e}")
            return {"error": str(e)}
    
    def generate_multiple_sequences(self, base_hash: str, count: int = 4) -> Dict[str, Any]:
        """Generate multiple sequences with 32-bit phase integration."""
        try:
            thermal_state = self._determine_thermal_state(base_hash)
            bit_phase_result = self.phase_bit_integration.resolve_bit_phase(base_hash, "auto")
            
            sequences = []
            for i in range(count):
                # Rotate hash for each sequence
                rotated_hash = self._rotate_hash(base_hash, i)
                sequence = self._generate_sequence_by_phase(rotated_hash, 256, bit_phase_result, thermal_state)
                sequences.append(sequence)
            
            return {
                "sequences": sequences,
                "count": count,
                "thermal_state": thermal_state,
                "bit_phase": bit_phase_result.bit_phase.value,
                "dualistic_mode": bit_phase_result.bit_phase == BitPhase.THIRTY_TWO_BIT
            }
            
        except Exception as e:
            logger.error(f"Error generating multiple sequences: {e}")
            return {"error": str(e)}
    
    def _determine_thermal_state(self, hash_value: str) -> str:
        """Determine thermal state based on hash complexity for bit sequencing."""
        # Simple hash-based thermal state determination
        hash_int = int(hash_value[:8], 16) if len(hash_value) >= 8 else hash(hash_value)
        
        if hash_int % 4 == 0:
            return COOL      # 4-bit operations
        elif hash_int % 4 == 1:
            return WARM      # 8-bit operations  
        elif hash_int % 4 == 2:
            return HOT       # 32-bit operations
        else:
            return CRITICAL  # 42-bit operations
    
    def _generate_sequence_by_phase(self, hash_value: str, length: int, bit_phase_result, thermal_state: str) -> List[int]:
        """Generate bit sequence based on bit phase and thermal state."""
        # Create seed from hash and bit phase
        seed = int(hash_value[:16], 16) + bit_phase_result.bit_phase.value
        
        # Adjust sequence generation based on thermal state
        thermal_multiplier = {
            COOL: 0.8,      # Shorter sequences for cool state
            WARM: 1.0,      # Base length for warm state
            HOT: 1.2,       # Longer sequences for hot state (32-bit)
            CRITICAL: 1.5   # Longest sequences for critical state
        }.get(thermal_state, 1.0)
        
        adjusted_length = int(length * thermal_multiplier)
        
        # Generate sequence using hash-based method
        sequence = []
        for i in range(adjusted_length):
            # Update hash for each bit
            bit_hash = hashlib.sha256(f"{hash_value}_{i}_{seed}".encode()).hexdigest()
            bit_value = int(bit_hash[:2], 16) % 2
            sequence.append(bit_value)
        
        return sequence
    
    def _calculate_sequence_metrics(self, sequence: List[int], bit_phase_result, thermal_state: str) -> Dict[str, float]:
        """Calculate sequence metrics based on bit phase and thermal state."""
        # Calculate basic metrics
        ones_count = sum(sequence)
        zeros_count = len(sequence) - ones_count
        entropy = self._calculate_entropy(sequence)
        
        # Adjust metrics based on thermal state
        thermal_multiplier = {
            COOL: 0.8, WARM: 1.0, HOT: 1.2, CRITICAL: 1.5
        }.get(thermal_state, 1.0)
        
        return {
            "length": len(sequence),
            "ones_ratio": ones_count / len(sequence),
            "zeros_ratio": zeros_count / len(sequence),
            "entropy": entropy * thermal_multiplier,
            "pattern_score": self._calculate_pattern_score(sequence) * thermal_multiplier
        }
    
    def _calculate_entropy(self, sequence: List[int]) -> float:
        """Calculate Shannon entropy of the sequence."""
        if not sequence:
            return 0.0
        
        ones_count = sum(sequence)
        zeros_count = len(sequence) - ones_count
        
        p1 = ones_count / len(sequence)
        p0 = zeros_count / len(sequence)
        
        if p1 == 0 or p0 == 0:
            return 0.0
        
        return -(p1 * np.log2(p1) + p0 * np.log2(p0))
    
    def _detect_patterns(self, sequence: List[int]) -> Dict[str, Any]:
        """Detect patterns in the sequence."""
        patterns = {
            "runs": self._analyze_runs(sequence),
            "alternations": self._count_alternations(sequence),
            "repetitions": self._find_repetitions(sequence)
        }
        return patterns
    
    def _analyze_runs(self, sequence: List[int]) -> Dict[str, int]:
        """Analyze runs of consecutive bits."""
        if not sequence:
            return {"max_run_ones": 0, "max_run_zeros": 0}
        
        max_run_ones = 0
        max_run_zeros = 0
        current_run_ones = 0
        current_run_zeros = 0
        
        for bit in sequence:
            if bit == 1:
                current_run_ones += 1
                current_run_zeros = 0
                max_run_ones = max(max_run_ones, current_run_ones)
            else:
                current_run_zeros += 1
                current_run_ones = 0
                max_run_zeros = max(max_run_zeros, current_run_zeros)
        
        return {"max_run_ones": max_run_ones, "max_run_zeros": max_run_zeros}
    
    def _count_alternations(self, sequence: List[int]) -> int:
        """Count alternations between 0 and 1."""
        if len(sequence) < 2:
            return 0
        
        alternations = 0
        for i in range(1, len(sequence)):
            if sequence[i] != sequence[i-1]:
                alternations += 1
        
        return alternations
    
    def _find_repetitions(self, sequence: List[int]) -> List[Dict[str, Any]]:
        """Find repeating patterns in the sequence."""
        # Simplified implementation - find basic repetitions
        repetitions = []
        for pattern_length in range(2, min(8, len(sequence)//2)):
            for start in range(len(sequence) - pattern_length):
                pattern = sequence[start:start + pattern_length]
                count = 0
                for i in range(start + pattern_length, len(sequence) - pattern_length + 1):
                    if sequence[i:i + pattern_length] == pattern:
                        count += 1
                if count > 0:
                    repetitions.append({
                        "pattern": pattern,
                        "count": count + 1,
                        "length": pattern_length
                    })
        
        return repetitions[:5]  # Return top 5 repetitions
    
    def _calculate_complexity(self, sequence: List[int]) -> float:
        """Calculate complexity score of the sequence."""
        if not sequence:
            return 0.0
        
        # Use Lempel-Ziv complexity approximation
        complexity = 1.0
        patterns = set()
        
        for i in range(len(sequence)):
            for j in range(i + 1, min(i + 8, len(sequence) + 1)):
                pattern = tuple(sequence[i:j])
                patterns.add(pattern)
        
        complexity = len(patterns) / len(sequence)
        return min(1.0, complexity)
    
    def _calculate_autocorrelation(self, sequence: List[int]) -> float:
        """Calculate autocorrelation of the sequence."""
        if len(sequence) < 2:
            return 0.0
        
        # Convert to numpy array for calculation
        seq_array = np.array(sequence, dtype=float)
        
        # Calculate autocorrelation
        autocorr = np.correlate(seq_array, seq_array, mode='full')
        autocorr = autocorr[len(autocorr)//2:]
        
        # Normalize
        autocorr = autocorr / autocorr[0]
        
        # Return lag-1 autocorrelation
        return float(autocorr[1]) if len(autocorr) > 1 else 0.0
    
    def _calculate_correlation(self, seq1: List[int], seq2: List[int]) -> float:
        """Calculate correlation between two sequences."""
        if len(seq1) != len(seq2) or len(seq1) == 0:
            return 0.0
        
        # Convert to numpy arrays
        arr1 = np.array(seq1, dtype=float)
        arr2 = np.array(seq2, dtype=float)
        
        # Calculate correlation coefficient
        correlation = np.corrcoef(arr1, arr2)[0, 1]
        return float(correlation) if not np.isnan(correlation) else 0.0
    
    def _calculate_hamming_distance(self, seq1: List[int], seq2: List[int]) -> int:
        """Calculate Hamming distance between two sequences."""
        if len(seq1) != len(seq2):
            return max(len(seq1), len(seq2))
        
        return sum(1 for a, b in zip(seq1, seq2) if a != b)
    
    def _calculate_similarity(self, seq1: List[int], seq2: List[int]) -> float:
        """Calculate similarity score between two sequences."""
        if len(seq1) != len(seq2) or len(seq1) == 0:
            return 0.0
        
        hamming_dist = self._calculate_hamming_distance(seq1, seq2)
        similarity = 1.0 - (hamming_dist / len(seq1))
        return max(0.0, similarity)
    
    def _calculate_pattern_score(self, sequence: List[int]) -> float:
        """Calculate pattern score for the sequence."""
        if not sequence:
            return 0.0
        
        # Calculate various pattern metrics
        entropy = self._calculate_entropy(sequence)
        complexity = self._calculate_complexity(sequence)
        alternations = self._count_alternations(sequence) / max(1, len(sequence) - 1)
        
        # Combine metrics into pattern score
        pattern_score = (entropy + complexity + alternations) / 3.0
        return min(1.0, pattern_score)
    
    def _rotate_hash(self, hash_value: str, rotation: int) -> str:
        """Rotate hash value for sequence generation."""
        if len(hash_value) < 2:
            return hash_value
        
        # Simple rotation by shifting characters
        rotated = hash_value[rotation:] + hash_value[:rotation]
        return rotated

