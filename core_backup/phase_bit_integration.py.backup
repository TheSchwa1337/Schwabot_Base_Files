print(f"  Phase Value: {result.phase_value:.4f}")
print(f"  Confidence: {result.confidence:.3f}")
print(f"  Processing Time: {result.processing_time:.6f}s")
print(f"  Mathematical Signature: {result.mathematical_signature}")
    
# Test bit sequence creation
sample_data = [1.2, 3.4, 2.1, 4.5, 1.8, 3.2]
bit_seq = phase_system.create_bit_sequence(sample_data, BitPhase.EIGHT_BIT)
    
print(f"\nBit Sequence:")
print(f"  Sequence: {bit_seq.sequence[:10]}...")  # Show first 10 elements
print(f"  Bit Phase: {bit_seq.bit_phase.value}")
print(f"  Mathematical Hash: {bit_seq.mathematical_hash}")
    
# Test strategy integration
market_conditions = {)
    "volatility": 0.7,
    "volume": 0.8,
    "trend_strength": 0.6
}
    
integrated_strategies = phase_system.integrate_strategies(result, market_conditions)
    
print(f"\nIntegrated Strategies:")
        for strategy, weight in integrated_strategies.items():
    print(f"  {strategy}: {weight:.3f}")
    
    # Show processing metrics
    metrics = phase_system.get_processing_metrics()
    print(f"\nProcessing Metrics:")
    print(f"  Total Operations: {metrics['processing_stats']['total_operations']}")
    print(f"  Cache Hit Rate: {metrics['cache_hit_rate']:.2%}")
    print(f"  Average Processing Time: {metrics['processing_stats']['average_processing_time']:.6f}s")
