# -*- coding: utf-8 -*-
"""
Socratic Signal Validator Module.

This module implements the 'Socratic Calculus' concept, serving as a reflexive 
questioning layer over stochastic inputs to analyze trade decisions and detect 
logic uncertainty.
"""

import logging
from typing import Any, Dict, List, Optional

logger = logging.getLogger(__name__)


class SocraticSignalValidator:
    """
    Implements the 'Socratic Calculus' concept, serving as a reflexive questioning layer
    over stochastic inputs to analyze trade decisions and detect logic uncertainty.
    Mathematical Logic: if condition: ask("Question?") -> Log hash-state marker.
    """

    def __init__(self, thresholds: Optional[Dict[str, float]] = None):
        """
        Initializes the SocraticSignalValidator.

        Args:
            thresholds: Configuration for various thresholds like `noise_threshold`, 
                       `drift_dominance_ratio`.
        """
        self.history: List[str] = []  # Stores questions/insights generated
        self.thresholds = thresholds if thresholds is not None else {
            "price_noise_threshold": 0.01,         # Absolute price delta below which is considered noise
            "drift_dominance_ratio": 1.5,          # Drift / Volatility ratio to consider drift dominant
            "chaos_volatility_threshold": 0.03     # Volatility above which is considered stochastic chaos
        }
        logger.info("SocraticSignalValidator initialized.")

    def ask(self, question: str, context: Optional[Dict[str, Any]] = None):
        """
        Logs a Socratic question or insight based on analyzed conditions.
        
        Args:
            question: The question or insight generated.
            context: Optional context to log with the question.
        """
        log_message = f"[SOCRATIC] {question}"
        if context:
            log_message += f" | Context: {context}"
        logger.debug(log_message)
        self.history.append(log_message)

    def analyze_trade_decision(self, trade_data: Dict[str, Any]):
        """
        Analyzes a trade decision or market state and poses Socratic questions.
        
        Args:
            trade_data: Dictionary containing relevant trade/market metrics.
                       Expected keys: 'price_delta', 'drift', 'volatility',
                       'profit' (optional), 'loss' (optional), 'sigma_zone' (optional).
        """
        price_delta = trade_data.get("price_delta", 0.0)
        drift = trade_data.get("drift", 0.0)
        volatility = trade_data.get("volatility", 0.0)
        profit = trade_data.get("profit")
        loss = trade_data.get("loss")
        sigma_zone = trade_data.get("sigma_zone")

        # Question 1: Is movement just Brownian noise?
        if abs(price_delta) < self.thresholds["price_noise_threshold"]:
            self.ask("Is this movement just Brownian noise? Is it too insignificant to act on?",
                     {"price_delta": f"{price_delta:.4f}"})

        # Question 2: Is this drift-dominant? Should I scale in?
        if volatility != 0 and drift / volatility > self.thresholds["drift_dominance_ratio"]:
            self.ask("Is this drift-dominant? Does the underlying trend support scaling in or out?",
                     {"drift": f"{drift:.4f}", "volatility": f"{volatility:.4f}"})

        # Question 3: Stochastic chaos – should I stay flat?
        if volatility > self.thresholds["chaos_volatility_threshold"] and abs(drift) < self.thresholds["price_noise_threshold"]:
            self.ask("Volatility is high but drift is low. Am I in stochastic chaos? Should I stay flat or reduce exposure?",
                     {"drift": f"{drift:.4f}", "volatility": f"{volatility:.4f}"})

        # Question 4: Martingale re-entry valid here? (Integrates with MartingaleGuard concept)
        if loss is not None and loss and sigma_zone is not None:
            # This check would ideally involve the MartingaleGuard directly
            self.ask(f"A loss occurred in sigma zone {sigma_zone}. Is a Martingale-like re-entry valid given current conditions?",
                     {"last_loss": loss, "sigma_zone": sigma_zone})

        # Question 5: Why was this profitable/unprofitable? (Reflexive analysis)
        if profit is not None:
            if profit > 0:
                self.ask("Why was this trade profitable? What unique factors converged?", {"profit": profit})
            elif profit < 0:
                self.ask("Why was this trade unprofitable? What unexpected divergence occurred?", {"profit": profit})

        logger.info("Socratic analysis complete for trade decision.")

    def get_socratic_history(self) -> List[str]:
        """
        Returns the history of Socratic questions/insights generated.
        
        Returns:
            List of Socratic questions and insights.
        """
        return list(self.history)

    def clear_history(self) -> None:
        """Clear the Socratic history."""
        self.history.clear()
        logger.info("Socratic history cleared")

    def get_analysis_summary(self) -> Dict[str, Any]:
        """
        Get a summary of the Socratic analysis.
        
        Returns:
            Dictionary containing analysis summary.
        """
        return {
            "total_questions": len(self.history),
            "recent_questions": self.history[-10:] if len(self.history) > 10 else self.history,
            "thresholds": self.thresholds.copy()
        }


if __name__ == "__main__":
    logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')

    validator = SocraticSignalValidator()

    print("\n--- Simulating Socratic Analysis ---")

    # Scenario 1: Low price delta, indicating noise
    print("\nScenario 1: Noise Detection")
    trade_data_1 = {"price_delta": 0.005, "drift": 0.001, "volatility": 0.002}
    validator.analyze_trade_decision(trade_data_1)

    # Scenario 2: High drift relative to volatility
    print("\nScenario 2: Drift Dominance")
    trade_data_2 = {"price_delta": 0.03, "drift": 0.02, "volatility": 0.005}
    validator.analyze_trade_decision(trade_data_2)

    # Scenario 3: High volatility, low drift (stochastic chaos)
    print("\nScenario 3: Stochastic Chaos")
    trade_data_3 = {"price_delta": 0.002, "drift": 0.0005, "volatility": 0.04}
    validator.analyze_trade_decision(trade_data_3)

    # Scenario 4: Loss in a specific sigma zone (Martingale check)
    print("\nScenario 4: Loss and Martingale Check")
    trade_data_4 = {"price_delta": -0.01, "drift": -0.005, "volatility": 0.01, "loss": True, "sigma_zone": 3}
    validator.analyze_trade_decision(trade_data_4)

    # Scenario 5: Profitable trade
    print("\nScenario 5: Profitable Trade")
    trade_data_5 = {"price_delta": 0.04, "drift": 0.03, "volatility": 0.008, "profit": 0.015}
    validator.analyze_trade_decision(trade_data_5)

    # Scenario 6: Unprofitable trade
    print("\nScenario 6: Unprofitable Trade")
    trade_data_6 = {"price_delta": -0.02, "drift": -0.01, "volatility": 0.012, "profit": -0.008}
    validator.analyze_trade_decision(trade_data_6)

    print("\n--- Socratic History ---")
    for entry in validator.get_socratic_history():
        print(entry) 