[flake8]
# CI-friendly configuration - focus on critical issues first
# Extended ignore for gradual improvement
extend-ignore = 
    D401,ANN101,ANN201,
    # Temporarily ignore style issues during architectural fixes
    W293,W291,W292,
    # Allow some complexity during refactoring
    C901,
    # Allow f-string issues during transition
    F541,
    # Allow some import order issues
    I100,I101,I201,I202,
    # Allow some docstring issues during development
    D100,D101,D103,D107,D200,D202,D205,D209,D211,D212,D300,D301,D402,D412,D415,D417

# Slightly more lenient line length
max-line-length = 100
# More lenient complexity during refactoring
max-complexity = 20

# Schwabot-specific exclusions
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    site-packages,
    node_modules,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    tests/deprecated/,
    sandbox/,
    build/,
    dist/,
    tools/

# Per-file exclusions for generated files
per-file-ignores =
    __init__.py:F401,F403
    tests/*:E722,W291,W293,F401,F841
    setup.py:E722,F401
    docs/*:E722,W291,W293,F401
    tools/*:E501,W291,W293,F401,F841,C901,S404,S603,S607
    *stub*.py:E999,F401,F841
    core/integration_orchestrator.py:C901
    core/main.py:C901

# Focus on critical errors first
select = 
    E9,
    F63,
    F7,
    F82

# Docstring settings
docstring-convention = google

# Import order
import-order-style = google

# Naming conventions - mathematical formulas need single letters
good-names = i,j,k,n,x,y,z,a,b,c,d,e,f,g,h,l,m,o,p,q,r,s,t,u,v,w,A,B,C,D,T
