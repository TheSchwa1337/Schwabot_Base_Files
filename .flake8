[flake8]
# Flake8 Configuration for Schwabot Trading System
# ================================================

# Maximum line length - increased for mathematical formulas
max-line-length = 120

# Maximum complexity for functions
max-complexity = 15

# Ignore specific error codes that conflict with Black formatting
extend-ignore = 
    E203,  # whitespace before ':' (handled by Black)
    E266,  # too many leading '#' for block comment
    E501,  # line too long (handled by max-line-length)
    W503,  # line break before binary operator (handled by Black)
    E265,  # block comment should start with '# '

# Exclude directories and files
exclude = 
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    build,
    dist,
    *.egg-info,
    .mypy_cache,
    .pytest_cache

# Per-file-ignores for mathematical modules
per-file-ignores = 
    # Allow longer lines in test files
    tests/*:E501
    # Allow imports in __init__.py files
    __init__.py:F401
    # Allow unused variables in mathematical formulas
    core/*:F841
    utils/*:F841

# Statistics
statistics = True

# Count errors
count = True

# Show source code
show-source = True

# Builtins
builtins = _

# Doctest
doctests = False

# Format
format = %(path)s:%(row)d:%(col)d: %(code)s %(text)s

# Jobs
jobs = auto

# Quiet
quiet = 0

# Select
select = E,W,F,C90

# Verbose
verbose = 0

# Filename
filename = *.py

# Min version
min-version = 3.8
