[flake8]
max-line-length = 100
ignore = 
    E203,  # whitespace before ':'
    E266,  # too many leading '#' for block comment
    E501,  # line too long (handled by max-line-length)
    W503,  # line break before binary operator
    W504,  # line break after binary operator
    E402,  # module level import not at top of file (needed for conditional imports)
    F401,  # imported but unused (some imports are for dynamic loading)
    F841,  # local variable assigned but never used (some are for future use)
    C901,  # too complex (some functions are intentionally complex)
    W605,  # invalid escape sequence (some are in docstrings)
    F541,  # f-string is missing placeholders (some are intentional)
    E999,  # syntax error (will be fixed manually)
    E128,  # continuation line under-indented for visual indent
    E124,  # closing bracket does not match visual indentation
    E131,  # continuation line unaligned for hanging indent
    E129,  # visually indented line with same indent as next logical line
    E127,  # continuation line over-indented for visual indent
    E305,  # expected 2 blank lines after class or function definition
    E261,  # at least two spaces before inline comment
    W292,  # no newline at end of file
    W291,  # trailing whitespace
    W293,  # blank line contains whitespace
    W505,  # doc line too long
    E502,  # the backslash is redundant between brackets
    E701,  # multiple statements on one line (colon)
    F821,  # undefined name
    F811,  # redefinition of an unused variable
    I201,  # missing newline between import groups
    I100,  # import statements are in wrong order
    D205,  # 1 blank line required between summary line and description
    D400,  # first line should end with a period

exclude = 
    .git,
    __pycache__,
    build,
    dist,
    venv,
    env,
    *.egg-info,
    .venv,
    .env,
    node_modules,
    .pytest_cache,
    .coverage,
    htmlcov,
    .tox,
    .mypy_cache

per-file-ignores =
    # Ignore specific violations in specific files
    __init__.py: F401
    test_*.py: F401, F841
    *_test.py: F401, F841
    */test/*: F401, F841
